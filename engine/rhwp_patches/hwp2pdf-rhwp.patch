+/// 저장 HWPX 인라인 1행 표에서 측정기가 셀 줄높이+줄간격 합으로 행을 키운 경우,
+/// 한/글이 저장한 줄 사슬과 표 높이가 함께 증언하는 높이로 되돌린다.
+///
+/// 셀 안 줄은 저장 vpos 에 놓이는데(배치도 그렇게 그린다) 측정은 줄높이+줄간격을
+/// 더한다. 한/글이 어떤 줄을 앞당겨 저장한 셀에서는 그 합이 사슬 끝보다 크다
+/// (사용자 기출문제지 1번 칸: 수식 줄 다음 vpos 가 합보다 200HU 앞 → 행 +2.6px, 표 아래
+/// 전체 +2.6px. 한컴 미리보기의 아래 테두리는 저장 표 높이와 맞았다).
+/// 합이 맞는 셀도 있으므로(KTX 목차 — 위 #2226 반례) 사슬만으로 정하지 않는다.
+/// 한 행의 어떤 셀에서 `사슬 끝 + 위아래 안 여백` 이 표 개체 높이와 **정확히** 같고,
+/// 그 셀의 사슬이 온전하며(첫 줄 0, 엄격히 증가, 글자처럼 취급하지 않는 개체 없음),
+/// 다른 어느 셀의 사슬도 그보다 길지 않을 때만 행을 표 높이로 줄인다.
+/// 또 줄이는 양이 저장 줄 사슬의 가장 작은 줄높이의 절반보다 작아야 한다 — 대체 글꼴로 글이
+/// 한 줄 더 넘친 칸(opengov 36382399 머리 표: 저장 한 줄 → rhwp 두 줄, 초과 17.3px)은 초과분이
+/// 적어도 한 줄이라 여기서 걸러진다. 저장 높이를 강제하면 넘친 줄이 칸 밖으로 나간다.
+pub fn fit_stored_inline_row_to_stored_ladder(
+    measured: &MeasuredTable,
+    table: &Table,
+    dpi: f64,
+) -> Option<MeasuredTable> {
+    if !table.common.treat_as_char
+        || table.row_count != 1
+        || measured.row_heights.len() != 1
+        || table.common.height == 0
+        || table.common.height >= 0x8000_0000
+        || table.cells.is_empty()
+        || table.cells.iter().any(|cell| cell.row_span != 1 || cell.text_direction != 0)
+    {
+        return None;
+    }
+    let target = i64::from(table.common.height);
+    let height = hwpunit_to_px(table.common.height as i32, dpi);
+    if measured.row_heights[0] <= height + 0.5 {
+        return None;
+    }
+    let chain_end = |cell: &crate::model::table::Cell| -> Option<i64> {
+        let mut previous: Option<i32> = None;
+        let mut end = 0i64;
+        for para in &cell.paragraphs {
+            if para.line_segs.is_empty() || para.stored_text_partition_is_dirty() {
+                return None;
+            }
+            if para.controls.iter().any(|c| {
+                matches!(
+                    c,
+                    Control::Table(_) | Control::Shape(_) | Control::Picture(_) | Control::Equation(_)
+                ) && !c.is_treat_as_char_object()
+            }) {
+                return None;
+            }
+            for seg in &para.line_segs {
+                if seg.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+                    || seg.vertical_pos < 0
+                    || seg.line_height <= 0
+                    || seg.is_first_line_of_page()
+                    || seg.is_first_line_of_column()
+                {
+                    return None;
+                }
+                match previous {
+                    None if seg.vertical_pos != 0 => return None,
+                    Some(pos) if seg.vertical_pos <= pos => return None,
+                    _ => {}
+                }
+                previous = Some(seg.vertical_pos);
+                end = end.max(i64::from(seg.vertical_pos) + i64::from(seg.line_height));
+            }
+        }
+        previous.map(|_| end)
+    };
+    let mut witnessed = false;
+    for cell in &table.cells {
+        let pad = cell.effective_padding(&table.padding);
+        let pad_v = i64::from(pad.top) + i64::from(pad.bottom);
+        match chain_end(cell) {
+            Some(end) if end + pad_v == target => witnessed = true,
+            Some(end) if end + pad_v > target => return None,
+            _ => {}
+        }
+    }
+    if !witnessed {
+        return None;
+    }
+    let min_line_hu = table
+        .cells
+        .iter()
+        .flat_map(|cell| cell.paragraphs.iter())
+        .flat_map(|para| para.line_segs.iter())
+        .map(|seg| seg.line_height)
+        .filter(|lh| *lh > 0)
+        .min()?;
+    if measured.row_heights[0] - height >= hwpunit_to_px(min_line_hu, dpi) / 2.0 {
+        return None;
+    }
+    let mut fitted = measured.clone();
+    fitted.total_height += height - fitted.row_heights[0];
+    fitted.row_heights[0] = height;
+    fitted.cumulative_heights = vec![0.0, height];
+    Some(fitted)
+}
