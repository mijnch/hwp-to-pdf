# 폴더 안 파이썬 환경. 대상 PC에서 engine/setup_env.py 가 새로 만든다.
# venv 는 이식되지 않는다 — pyvenv.cfg 에 만들어진 PC의 파이썬 절대경로가 박힌다.
engine/venv/

# 변환 엔진 rhwp 실행 파일 (31MB). setup_env.py 가 릴리스에서 받아 지문을 대조한다.
engine/rhwp/

# 작업용 임시 폴더 — %TEMP% 대신 여기 쓴다(도구가 폴더 밖을 더럽히지 않게)
.tmp/

# 사용자 자료
HWP 입력/
PDF 출력/

# 파이썬
__pycache__/
*.pyc
*.pyo

# 백업 사본
*.bak
*.bak_*

# 실행 기록 (개인 사용 흔적)
실행기록.txt

# 중복 실행 방지 잠금 (런타임 산물)
engine/.lock
